{
  "name": "anomer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5190 --strictPort",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint src/ tests/",
    "test": "tsx --test tests/*.test.ts",
    "type-check": "react-router typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply anomer --local",
    "db:migrate": "wrangler d1 migrations apply anomer --remote"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@tanstack/react-query": "^5.105.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "i18next": "^26.5.11",
    "isbot": "^5.2.2",
    "lucide-react": "^1.61.0",
    "openai": "^7.44.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  }
}
